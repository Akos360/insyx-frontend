# Backend API base URL
# Use 127.0.0.1, not localhost — on Windows w/ Docker Desktop, localhost can resolve
# to ::1 and the IPv6 path resets connections to published container ports.
VITE_API_BASE_URL=http://127.0.0.1:3000

# MapTiler API key — get a free key at maptiler.com
# Restrict this key to your domain in the MapTiler dashboard
VITE_MAPTILER_KEY=your_maptiler_key_here
